# App
PORT=3000

# Postgres — one primary + one replica per shard
PGUSER=postgres
PGPASSWORD=changeme
PGDATABASE=linkshrink

SHARD_COUNT=2

SHARD0_PRIMARY_HOST=localhost
SHARD0_PRIMARY_PORT=5432
SHARD0_REPLICA_HOST=localhost
SHARD0_REPLICA_PORT=5433

SHARD1_PRIMARY_HOST=localhost
SHARD1_PRIMARY_PORT=5434
SHARD1_REPLICA_HOST=localhost
SHARD1_REPLICA_PORT=5435

# Cache
CACHE_HOST=localhost
CACHE_PORT=6379
