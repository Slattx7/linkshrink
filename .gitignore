# ==============================================================================
# linkshrink - Comprehensive Git Ignore
# ==============================================================================

# Node dependencies & caches
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
*.tsbuildinfo

# Environment & credentials
.env
.env.*
!.env.example
*.key
*.pem

# Logs & Debug Captures
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
pids/
*.pid
*.seed
*.pid.lock

# Test & benchmark outputs
coverage/
.nyc_output/
*.k6.json
*.k6.csv

# IDE & OS Artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
